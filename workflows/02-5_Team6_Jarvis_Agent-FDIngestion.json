        "query": "SELECT \n  COUNT(*) FILTER (WHERE financial_analysis_status = 'complete') as completed_count,\n  COUNT(*) as total_count\nFROM track_requests\nWHERE portfolio_id = '{{ $('Code-Fetch from Webhook').item.json.portfolio_id }}'",
