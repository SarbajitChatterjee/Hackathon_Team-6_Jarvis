      "parameters": {
        "jsCode": "// Extract the webhook payload from Supabase\nconst body = items[0].json.body;\n\n// Supabase webhook structure has the record inside body\nconst record = body.record;\n\nconst start_date = record.start_date;            // New additions\nconst end_date = record.end_date;                // New additions\n\nreturn [{\n  json: {\n    request_id: record.request_id,\n    ticker: record.ticker,\n    portfolio_id: record.portfolio_id,\n    start_date,\n    end_date,\n    // status: record.status,                   // status changed to ticker_status\n    ticker_status: record.ticker_status,\n    financial_analysis_status: record.financial_analysis_status\n  }\n}];"
