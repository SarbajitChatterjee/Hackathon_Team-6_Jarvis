    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH counts AS (\n    SELECT \n        (SELECT COUNT(*) FROM track_requests WHERE portfolio_id = $1 AND financial_analysis_status = 'complete') as completed_count,\n        (SELECT ticker_count FROM portfolios WHERE id = $1) as total_count\n)\nUPDATE portfolios\nSET fdi_status = 'finished'\nWHERE id = $1 \n  AND (SELECT completed_count FROM counts) = (SELECT total_count FROM counts)\n  AND fdi_status IS DISTINCT FROM 'finished'  -- New addition\nRETURNING fdi_status;",
        "options": {
          "queryReplacement": "={{ $('Code-Fetch from Webhook').item.json.portfolio_id }}"
        }
      },
