      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  p.ticker_count AS target_total,\n  COUNT(tr.request_id) AS current_completed\nFROM portfolios p\nLEFT JOIN track_requests tr\n  ON tr.portfolio_id = p.id\n AND tr.financial_analysis_status = 'complete'\nWHERE p.id = $1\nGROUP BY p.ticker_count;",
