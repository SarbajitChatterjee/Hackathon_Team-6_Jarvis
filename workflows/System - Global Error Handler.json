    {
      "parameters": {
        "jsCode": "// Get the full error object\nconst root = $input.first();\nconst item = root.json;\n\n// --- 1. The Sherlock Holmes Function ---\n// Recursively searches the entire object tree for \"request_id\"\nfunction findRequestId(obj, depth = 0) {\n  if (!obj || typeof obj !== 'object' || depth > 5) return null;\n  \n  // Check immediate keys\n  if (obj.request_id) return obj.request_id;\n  if (obj.body && obj.body.request_id) return obj.body.request_id;\n  \n  // Search deeper\n  for (const key of Object.keys(obj)) {\n    // Skip huge internal n8n objects to save time\n    if (key === 'workflow' || key === 'stack') continue; \n    \n    const found = findRequestId(obj[key], depth + 1);\n    if (found) return found;\n  }\n  return null;\n}\n\n// --- 2. Execute Search ---\nlet requestId = findRequestId(item);\n\n// Fallback: If not found, try to grab it from the \"Input Data\" of the failing node if available\nif (!requestId && item.execution?.lastNodeExecuted) {\n   // Sometimes n8n puts the node name here, but not the data. \n   // This is just a fallback attempt.\n}\n\n// --- 3. Capture Error Message ---\nconst errorMsg = \n  item.execution?.error?.message || \n  item.message || \n  item.error?.message ||\n  \"Unknown System Error\";\n\n// --- 4. Return Clean Data ---\nreturn {\n  json: {\n    target_request_id: requestId, // This is what your Postgres node needs\n    error_message: errorMsg,\n    failed_workflow: item.workflow?.name || \"Unknown Workflow\"\n  }\n};"
      },
