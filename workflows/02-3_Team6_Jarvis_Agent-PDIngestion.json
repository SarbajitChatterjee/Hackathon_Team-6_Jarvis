      "parameters": {
        "jsCode": "// 1) Extract AI response text (Modal 1 output)\nconst aiText =\n  $json?.output?.[0]?.content?.find(c => c.type === \"output_text\")?.text\n  ?? $json?.output?.[0]?.content?.[0]?.text\n  ?? $json?.text\n  ?? $json?.response\n  ?? $json?.content\n  ?? \"\";\n\nif (!String(aiText).trim()) {\n  throw new Error(\"Could not find AI text. Expected $json.output[0].content[*].text\");\n}\n\n// 2) Clean code fences (if model ever adds them)\nlet s = String(aiText)\n  .trim()\n  .replace(/^```(?:json)?\\s*/i, \"\")\n  .replace(/```$/i, \"\")\n  .trim();\n\n// 3) Parse JSON\nlet parsed;\ntry {\n  parsed = JSON.parse(s);\n} catch (e) {\n  throw new Error(\"AI output is not valid JSON. First 300 chars:\\n\" + s.slice(0, 300));\n}\n\n// 4) Pull request_id + ticker (must exist from upstream)\n// Adjust node name if yours differs\nconst reqNode =\n  $node[\"Temporary create request\"]?.json ??\n  $node[\"Create Request in track_requests DB\"]?.json ??  // fallback if you later re-enable it\n  null;\n\nconst request_id = $json.request_id ?? reqNode?.request_id;\nconst ticker = $json.ticker ?? reqNode?.ticker;\n\nif (!request_id) throw new Error(\"Missing request_id. Ensure your create-request node ran and returned it.\");\nif (!ticker) throw new Error(\"Missing ticker. Ensure your create-request node ran and returned it.\");\n\n\n// 5) summary_payload: store the whole parsed JSON (or parsed.summary_payload if you use that envelope)\nconst summary_payload = parsed.summary_payload ?? parsed;\n\n// 6) patent_count: choose the best available source\n// - if AI returns a count, use it\n// - else if AI returns patents array, use length\nconst patent_count =\n  Number(parsed.patent_count ?? summary_payload.patent_count) ||\n  (Array.isArray(summary_payload.patents) ? summary_payload.patents.length : 0);\n\n// 7) created_at (only needed if DB doesn't default to now())\nconst created_at = new Date().toISOString();\n\n// 8) Output one item shaped exactly for your Postgres Insert node\nreturn [\n  {\n    json: {\n      request_id,\n      ticker,\n      summary_payload,\n      patent_count,\n      created_at,\n    },\n  },\n];"
      },
