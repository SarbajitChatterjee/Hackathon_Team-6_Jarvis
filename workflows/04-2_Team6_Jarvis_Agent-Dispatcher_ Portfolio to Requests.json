{
  "name": "Team6_Jarvis_Agent-Dispatcher: Portfolio to Requests",
  "nodes": [
    {
      "parameters": {
        "jsCode": "// Supabase webhook delivers the new row here:\nconst rec = items[0].json.body?.record;\n// Validate\nif (!rec || !Array.isArray(rec.input_tickers)) {\n  return [];\n}\n// Clean tickers\nconst tickers = rec.input_tickers\n  .map(t => String(t).trim())\n  .filter(Boolean);\n\nconst ticker_count = tickers.length;  // ADD THIS\n\n// Fan-out: 1 ticker = 1 output item\nreturn tickers.map(ticker => ({\n  json: {\n    portfolio_id: rec.id,\n    ticker,\n    ticker_count,                      // ADD THIS\n    // status: 'pending'               // To handle this lifecycle later\n    status: 'processing'\n  }\n}));"
      },
