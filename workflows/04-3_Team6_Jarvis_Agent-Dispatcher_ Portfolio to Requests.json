    {
      "parameters": {
        "jsCode": "// Aggregate the multiple insert results back to one portfolio update\nconst ticker_count = items.length; // Count how many items were inserted\nconst portfolio_id = items[0].json.portfolio_id; // Get portfolio_id from first item\n\nreturn [{\n  json: {\n    portfolio_id: portfolio_id,\n    ticker_count: ticker_count,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        72
      ],
      "id": "d8d8b4df-333d-4dde-b556-a06f6c289261",
      "name": "Pass Ticker_count"
    },
    {
      "parameters": {
        "jsCode": "// Supabase webhook delivers the new row here:\nconst rec = items[0].json.body?.record;\n// Validate\nif (!rec || !Array.isArray(rec.input_tickers)) {\n  return [];\n}\n// Clean tickers\nconst tickers = rec.input_tickers\n  .map(t => String(t).trim())\n  .filter(Boolean);\n\nconst ticker_count = tickers.length;\nconst start_date = rec.start_date;            // New additions\nconst end_date = rec.end_date;                // New additions\n\n// Fan-out: 1 ticker = 1 output item\nreturn tickers.map(ticker => ({\n  json: {\n    portfolio_id: rec.id,\n    ticker,\n    ticker_count,\n    start_date,\n    end_date,\n    // status: 'pending'               // To handle this lifecycle later\n    status: 'processing'\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        72
      ],
